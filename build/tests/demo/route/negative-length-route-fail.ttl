@prefix geojson: <https://purl.org/geojson/vocab#> .
@prefix ns1: <http://www.opengis.net/def/dataType/OGC/1.1/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<file:///github/workspace/test-route-2> a geojson:Feature ;
    rdfs:label "Route with an impossible length" ;
    ns1:length -50 ;
    geojson:geometry [ a geojson:MultiLineString ;
            geojson:coordinates ( ( ( -3.7038e+00 4.04168e+01 ) ( -3.69e+00 4.042e+01 ) ) ) ] .

